# Server
PORT=3030
NODE_ENV=development

# CORS (Vite dev = http://localhost:5174)
CORS_ORIGIN=http://localhost:5174

# Credenciais do login compartilhado (TROCAR antes de subir!)
AUTH_USERNAME=admin
AUTH_PASSWORD=trocar-essa-senha-antes-de-subir

# Pasta de dados persistente (deve ser volume no docker)
DATA_DIR=./data

# Cookie session (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=devsecret-change-me-please-32chars-min-please
SESSION_TTL_DAYS=30

# Shopee Open Platform (push webhook)
# Test Push Partner Key do console Shopee
SHOPEE_PARTNER_KEY=
# URL exata do Test Call Back URL (recomendado em produção atrás de proxy)
# SHOPEE_PUSH_CALLBACK_URL=https://planilha.guilhermesales.com/api/shopee/push
# Partner ID (número) do app no console Shopee
SHOPEE_PARTNER_ID=
# production ou sandbox
SHOPEE_ENV=production
# Redirect OAuth cadastrado no app Shopee
# SHOPEE_REDIRECT_URL=https://planilha.guilhermesales.com/api/shopee/oauth/callback
